# special characters that titles start with
regexp=^[\w-]+ \w+ ([^ A-Za-z0-9.])+\s
colours=white
=======
# colon following "WIP"
regexp=WIP:
colours=cyan
=======
# "WIP" prefix
regexp=^[\w-]+ \w+ WIP
colours=white
=======
# commits to delete
regexp=^[\w-]+ \w+ --.*
colours=red
=======
# dates
regexp=^[\w-]+ \w+
colours=blue
=======
# SHAs
regexp=^[\w-]+
colours=yellow
=======
# interpunction following ticket numbers
regexp=(#\d+)|(#?[A-Z][A-Z0-9]*-\d+)[,:]
colours=cyan
=======
# ticket numbers
regexp=(#\d+)|(#?[A-Z][A-Z0-9]*-\d+)
colours=blue
